# =============================================================================
# Secrets, signing keys & local environment config
# NEVER commit these — this is a banking app.
# =============================================================================
# Environment files (keep a committed template instead)
.env
.env.*
*.env
!.env.example
!.env.sample

# --dart-define-from-file configs (AppConfig reads API_BASE_URL, USE_MOCK, ...)
dart_defines*.json
dart-defines*.json
/config/*.json
!/config/*.example.json

# Android signing
**/android/key.properties
*.jks
*.keystore
!debug.keystore
upload-keystore*

# iOS / Apple signing
*.p12
*.p8
*.cer
*.mobileprovision
*.provisionprofile
AuthKey_*.p8

# Firebase / Google service configs
**/android/app/google-services.json
**/ios/Runner/GoogleService-Info.plist
**/macos/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Generic key / credential material
*.pem
*.key
*.crt
secrets.*
credentials.*
service-account*.json

# Fastlane (if added later)
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output
**/fastlane/.env*

